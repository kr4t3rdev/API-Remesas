generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum TransactionType {
  COMPRA
  VENTA
}

enum ReconciliationStatus {
  PENDIENTE
  RECONCILIADO
}

enum AdjustmentType {
  INGRESO
  EGRESO
}

enum RateType {
  ACTUAL
  CUSTOM
}

enum RateSource {
  MANUAL
  SYSTEM
}

enum ObjectiveStatus {
  ACTIVO
  COMPLETADO
  PAUSADO
}

enum BillingCycle {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

enum LicenseState {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum NotificationType {
  NEW_USER_REGISTERED
  USER_TEMP_BLOCKED
  USER_BANNED
  LICENSE_EXPIRING
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum NotificationChannel {
  IN_APP
  WEBHOOK
  EMAIL
}

model User {
  id        Int      @id @default(autoincrement())
  email    String   @unique
  password String
  name     String
  nickname String?
  avatarUrl String?
  role      Role    @default(USER)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  blockedUntil        DateTime?
  isBanned            Boolean   @default(false)
  bannedUntil         DateTime?
  mustChangePassword  Boolean   @default(false)
  
  // Email verification fields
  emailVerified        Boolean   @default(false)
  verificationToken    String?
  verificationExpires DateTime?
  verificationSentAt  DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  
  primaryCurrencyId Int?
  primaryCurrency   Currency? @relation("PrimaryCurrency", fields: [primaryCurrencyId], references: [id])
  
  exchangeRates     ExchangeRate[]
  transactions       Transaction[]
  cashBalances       CashBalance[]
  cashAudits         CashAudit[]
  cashAdjustments    CashAdjustment[]
  bankAccounts       BankAccount[]
  expenses           Expense[]
  objectives         Objective[]
  rateHistory        RateHistory[]
  licenses           UserLicense[]
  subscriptionPayments SubscriptionPayment[]
  notifications      Notification[]
  adminAuditLogs     AdminAuditLog[] @relation("AdminAuditActor")
  workers            Worker[]
  expenseItems       ExpenseItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([isActive])
  @@index([blockedUntil])
  @@index([isBanned, bannedUntil])
  @@index([verificationToken])
  @@index([verificationExpires])
  @@index([passwordResetToken])
  @@index([passwordResetExpires])
  @@map("users")
}

model Currency {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  
  exchangeRates      ExchangeRate[]
  transactions       Transaction[]
  cashBalances       CashBalance[]
  cashAudits         CashAudit[]
  cashAdjustments    CashAdjustment[]
  bankAccounts       BankAccount[]
  expenses           Expense[]
  objectives         Objective[]
  rateHistoryFrom    RateHistory[]  @relation("RateFrom")
  rateHistoryTo      RateHistory[]  @relation("RateTo")
  primaryUsers       User[]         @relation("PrimaryCurrency")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([code])
  @@map("currencies")
}

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyId     Int
  currency       Currency @relation(fields: [currencyId], references: [id])
  referenceRate  Decimal  @db.Decimal(10, 4)
  buyMargin      Decimal  @db.Decimal(5, 4)
  sellMargin     Decimal  @db.Decimal(5, 4)
  effectiveDate  DateTime @default(now())
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, currencyId])
  @@index([userId, currencyId, effectiveDate])
  @@map("exchange_rates")
}

model Transaction {
  id            Int                  @id @default(autoincrement())
  userId        Int
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  currencyId    Int
  currency      Currency             @relation(fields: [currencyId], references: [id])
  amount        Decimal              @db.Decimal(15, 2)
  rate          Decimal              @db.Decimal(10, 4)
  totalCup      Decimal              @db.Decimal(15, 2)
  marginProfit  Decimal              @db.Decimal(15, 2)
  status        ReconciliationStatus @default(PENDIENTE)
  notes         String?
  
  incomeReconciliation IncomeReconciliation?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, type, createdAt])
  @@index([userId, currencyId, createdAt])
  @@index([userId, status])
  @@map("transactions")
}

model CashBalance {
  id         Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyId Int
  currency   Currency @relation(fields: [currencyId], references: [id])
  balance    Decimal  @db.Decimal(15, 2) @default(0)
  
  updatedAt DateTime @updatedAt
  
  @@unique([userId, currencyId])
  @@map("cash_balances")
}

model CashAudit {
  id              Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyId      Int
  currency        Currency @relation(fields: [currencyId], references: [id])
  expectedBalance Decimal  @db.Decimal(15, 2)
  actualBalance   Decimal  @db.Decimal(15, 2)
  difference      Decimal  @db.Decimal(15, 2)
  notes           String?
  
  createdAt DateTime @default(now())
  
  @@index([userId, currencyId, createdAt])
  @@map("cash_audits")
}

model CashAdjustment {
  id         Int            @id @default(autoincrement())
  userId    Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyId Int
  currency   Currency       @relation(fields: [currencyId], references: [id])
  amount     Decimal        @db.Decimal(15, 2)
  type       AdjustmentType
  reason     String
  
  createdAt DateTime @default(now())
  
  @@index([userId, currencyId, createdAt])
  @@map("cash_adjustments")
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  bankName      String
  currencyId    Int
  currency      Currency @relation(fields: [currencyId], references: [id])
  accountNumber String
  balance       Decimal  @db.Decimal(15, 2) @default(0)
  isActive      Boolean  @default(true)
  
  expenseReconciliations  ExpenseReconciliation[]
  incomeReconciliations   IncomeReconciliation[]
  objectives              Objective[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@map("bank_accounts")
}

model Expense {
  id          Int                  @id @default(autoincrement())
  userId      Int
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal              @db.Decimal(15, 2)
  currencyId  Int
  currency    Currency             @relation(fields: [currencyId], references: [id])
  category    String
  date        DateTime
  status      ReconciliationStatus @default(PENDIENTE)
  notes       String?
  
  reconciliation ExpenseReconciliation?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, category, date])
  @@index([userId, status])
  @@map("expenses")
}

model ExpenseReconciliation {
  id            Int        @id @default(autoincrement())
  expenseId     Int        @unique
  expense       Expense    @relation(fields: [expenseId], references: [id])
  bankAccountId Int
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  amount        Decimal    @db.Decimal(15, 2)
  appliedRate   Decimal?   @db.Decimal(10, 4)
  rateType      RateType?
  notes         String?
  
  createdAt DateTime @default(now())
  
  @@index([bankAccountId, createdAt])
  @@map("expense_reconciliations")
}

model IncomeReconciliation {
  id            Int         @id @default(autoincrement())
  transactionId Int         @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  bankAccountId Int
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  amount        Decimal     @db.Decimal(15, 2)
  appliedRate   Decimal?    @db.Decimal(10, 4)
  rateType      RateType?
  notes         String?
  
  createdAt DateTime @default(now())
  
  @@index([bankAccountId, createdAt])
  @@map("income_reconciliations")
}

model RateHistory {
  id             Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyFromId Int
  currencyFrom   Currency @relation("RateFrom", fields: [currencyFromId], references: [id])
  currencyToId   Int
  currencyTo     Currency @relation("RateTo", fields: [currencyToId], references: [id])
  rate           Decimal  @db.Decimal(10, 4)
  source         RateSource
  referenceType  String?
  referenceId    Int?
  
  createdAt DateTime @default(now())
  
  @@index([userId, currencyFromId, currencyToId, createdAt])
  @@map("rate_history")
}

model Objective {
  id            Int             @id @default(autoincrement())
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  targetAmount  Decimal         @db.Decimal(15, 2)
  currentAmount Decimal         @db.Decimal(15, 2) @default(0)
  currencyId    Int
  currency      Currency        @relation(fields: [currencyId], references: [id])
  bankAccountId Int?
  bankAccount   BankAccount?    @relation(fields: [bankAccountId], references: [id])
  status        ObjectiveStatus @default(ACTIVO)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  
  @@index([userId, status])
  @@map("objectives")
}

model Plan {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true)

  monthlyUsd    Decimal  @db.Decimal(10, 2) @default(15.00)
  semiannualUsd Decimal  @db.Decimal(10, 2) @default(85.50)
  annualUsd     Decimal  @db.Decimal(10, 2) @default(162.00)

  licenses             UserLicense[]
  subscriptionPayments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("plans")
}

model UserLicense {
  id               Int          @id @default(autoincrement())
  userId           Int
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           Int
  plan             Plan         @relation(fields: [planId], references: [id])
  state            LicenseState @default(TRIAL)
  cycle            BillingCycle @default(MONTHLY)
  startedAt        DateTime     @default(now())
  expiresAt        DateTime
  graceUntil       DateTime?
  cancelledAt      DateTime?
  lastPaymentAt    DateTime?

  events               LicenseEvent[]
  subscriptionPayments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, state])
  @@index([expiresAt, state])
  @@map("user_licenses")
}

model LicenseEvent {
  id            Int          @id @default(autoincrement())
  userLicenseId Int
  userLicense   UserLicense  @relation(fields: [userLicenseId], references: [id])
  fromState     LicenseState?
  toState       LicenseState
  reason        String?

  createdAt DateTime @default(now())

  @@index([userLicenseId, createdAt])
  @@map("license_events")
}

model SubscriptionPayment {
  id               Int          @id @default(autoincrement())
  userId           Int
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userLicenseId    Int?
  userLicense      UserLicense? @relation(fields: [userLicenseId], references: [id])
  planId           Int
  plan             Plan         @relation(fields: [planId], references: [id])
  cycle            BillingCycle
  amountUsd        Decimal      @db.Decimal(12, 2)
  exchangeRateUsed Decimal      @db.Decimal(10, 4)
  amountCup        Decimal      @db.Decimal(15, 2)
  paidAt           DateTime
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, paidAt])
  @@index([planId, cycle])
  @@map("subscription_payments")
}

model Notification {
  id        Int               @id @default(autoincrement())
  userId    Int?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      NotificationType
  channel   NotificationChannel
  title     String
  message   String
  payload   Json?
  readAt    DateTime?
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model AdminAuditLog {
  id             Int      @id @default(autoincrement())
  actorUserId    Int
  actorUser      User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUserId   Int?
  action         String
  previousValue  Json?
  newValue       Json?
  reason         String?
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_logs")
}

enum WorkerTransactionType {
  TRANSACTION
  BALANCE_ADD
}

model Worker {
  id                 Int       @id @default(autoincrement())
  userId             Int
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  phone              String?
  photoUrl           String?
  initials           String    // 2 letras nombre + 1era apellido en mayúscula
  balance            Decimal   @db.Decimal(15, 2) @default(0)
  accumulatedProfit  Decimal   @db.Decimal(15, 2) @default(0)
  totalDelivered     Decimal   @db.Decimal(15, 2) @default(0)
  
  transactions       WorkerTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("workers")
}

model WorkerTransaction {
  id             Int                 @id @default(autoincrement())
  workerId       Int
  worker         Worker              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type           WorkerTransactionType
  amount         Decimal             @db.Decimal(15, 2)
  profit         Decimal?            @db.Decimal(15, 2) // Solo para TRANSACTION
  balanceBefore  Decimal             @db.Decimal(15, 2)
  balanceAfter   Decimal             @db.Decimal(15, 2)
  description    String?

  createdAt DateTime @default(now())

  @@index([workerId, createdAt])
  @@map("worker_transactions")
}

model ExpenseItem {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  amount    Decimal   @db.Decimal(15, 2)
  category  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, createdAt])
  @@index([userId, category])
  @@map("expense_items")
}
